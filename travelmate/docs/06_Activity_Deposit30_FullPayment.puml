@startuml TravelMate_Activity_Deposit30_FullPayment
!theme plain
skinparam activityBackgroundColor #E8F4FD
skinparam activityBorderColor #2980B9
skinparam activityDiamondBackgroundColor #FFF3CD
skinparam activityDiamondBorderColor #E67E22
skinparam arrowColor #2C3E50

title TravelMate — Activity Diagram: DEPOSIT_30 vs FULL_PAYMENT

|User|
start
:Tìm kiếm và chọn phòng/căn;
:Điền ngày, số khách, số lượng;
:Nhập voucher nếu có;
:Chọn hình thức thanh toán;

|BookingService|
:Validate ngày, số lượng còn, voucher;
if (Hợp lệ?) then (Có)
    :Tính totalAmount, discountAmount;
else (Không)
    |User|
    :Hiển thị lỗi để chọn lại;
    stop
endif

if (Payment option?) then (DEPOSIT_30)
    |BookingService|
    :paidAmount = floor(totalAmount x 30%);
    :remainingAmount = totalAmount - paidAmount;
    :Tạo Booking + Payment\nPENDING_PAYMENT;

    |User|
    :Thanh toán 30% qua VNPAY;

else (FULL_PAYMENT)
    |BookingService|
    :paidAmount = totalAmount;
    :remainingAmount = 0;
    :Tạo Booking + Payment\nPENDING_PAYMENT;

    |User|
    :Thanh toán 100% qua VNPAY;
endif

|VNPAY|
:Trả kết quả về TravelMate;

|PaymentController|
if (VNPAY thành công và chữ ký hợp lệ?) then (Thành công)
    :Payment -> APPROVED;
    :Booking -> CONFIRMED;
    :partnerStatus -> PENDING_PARTNER_CONFIRMATION;
    :Thông báo Partner xác nhận giữ phòng;
else (Thất bại / hủy)
    :Payment -> FAILED/CANCELLED/EXPIRED;
    :Booking -> CANCELLED;
    :Mở lại phòng/căn;
    |User|
    :Xem kết quả thanh toán thất bại;
    stop
endif

|User|
:Xem kết quả\n"Đã thanh toán - chờ đối tác xác nhận";

|Partner|
:Mở /partner/bookings;
if (Đối tác xác nhận giữ phòng?) then (Xác nhận)
    :partnerStatus -> PARTNER_CONFIRMED;
else (Từ chối)
    :partnerStatus -> PARTNER_CANCELLED;
    |Admin|
    :Xử lý hủy / hoàn tiền / liên hệ khách;
    stop
endif

|Partner|
if (Khách đến check-in?) then (Có)
    :Booking -> CHECKED_IN;
    if (DEPOSIT_30?) then (Có)
        :Thu 70% tại cơ sở;
        :remainingPaymentStatus -> PAID_AT_PROPERTY;
    endif
    :Check-out;
    :Booking -> COMPLETED;
else (Không đến)
    if (DEPOSIT_30?) then (Có)
        :Booking -> NO_SHOW;
        :Payment -> DEPOSIT_FORFEITED;
        :Mở lại phòng/căn;
    else (FULL_PAYMENT)
        :Giữ booking để Admin/Partner xử lý\nchính sách hoàn tiền hoặc khiếu nại;
    endif
endif

|User|
if (User hủy booking đã thanh toán?) then (Có)
    :Booking -> CANCELLED;
    :Payment -> REFUND_PENDING;
    |Admin|
    :Xử lý hoàn tiền ngoài hệ thống;
endif

|Admin|
:Tạo quyết toán tháng;
:Chỉ lấy ONLINE + COMPLETED + APPROVED\nhoặc ONLINE + NO_SHOW + DEPOSIT_FORFEITED;
:Trừ commission và voucher costBearer=PARTNER;
:Tạo PartnerSettlement PENDING;
:Xác nhận đã chuyển khoản -> PAID\nvà cộng ví Partner;

stop
@enduml
