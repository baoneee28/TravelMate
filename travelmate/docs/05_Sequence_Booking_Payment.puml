@startuml TravelMate_Sequence_Booking_Payment
!theme plain
skinparam sequenceArrowThickness 2
skinparam sequenceParticipantBorderColor #2980B9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam noteBorderColor #E67E22
skinparam noteBackgroundColor #FFF3CD

title TravelMate — Sequence Diagram: Booking + VNPAY Auto Confirm

actor "User" as User
participant "Browser\n(Thymeleaf)" as Browser
participant "BookingController" as BookingCtrl
participant "BookingService" as BookingSvc
participant "VoucherService" as VoucherSvc
participant "PaymentController" as PayCtrl
participant "VnpayService" as VnpaySvc
participant "NotificationService" as NotifySvc
participant "PartnerPageController" as PartnerCtrl
participant "AdminPageController" as AdminCtrl
database "MySQL DB" as DB
participant "VNPAY\nSandbox" as VNPAY

== 1. User tạo booking ==

User -> Browser : Chọn phòng/căn và bấm "Đặt phòng"
Browser -> BookingCtrl : GET /booking?roomId=...
BookingCtrl -> DB : Load room + accommodation
DB --> BookingCtrl : Dữ liệu phòng/căn
BookingCtrl --> Browser : booking.html

User -> Browser : Nhập ngày, số khách, số lượng,\npaymentOption, voucherCode
Browser -> BookingCtrl : POST /booking/confirm
BookingCtrl -> BookingSvc : createBooking(...)

BookingSvc -> BookingSvc : Validate ngày và số lượng còn
opt User nhập voucher
    BookingSvc -> VoucherSvc : validate + calculateDiscount
    VoucherSvc -> DB : SELECT voucher + scope/assignment
    DB --> VoucherSvc : Voucher hợp lệ
    VoucherSvc --> BookingSvc : discountAmount + costBearer
end

BookingSvc -> BookingSvc : Tính totalAmount, paidAmount,\nremainingAmount
note right
DEPOSIT_30: thu 30% online, còn 70% tại cơ sở
FULL_PAYMENT: thu 100% online
end note

BookingSvc -> DB : INSERT Booking\nstatus=PENDING_PAYMENT\npaymentStatus=PENDING_PAYMENT
BookingSvc -> DB : INSERT Payment\nstatus=PENDING_PAYMENT
BookingSvc -> DB : Giữ phòng/căn tạm thời
BookingSvc --> BookingCtrl : Booking
BookingCtrl --> Browser : redirect /payment/vnpay/create/{bookingId}

== 2. Tạo URL VNPAY ==

Browser -> PayCtrl : GET /payment/vnpay/create/{bookingId}
PayCtrl -> VnpaySvc : buildPaymentUrl(booking, paidAmount)
VnpaySvc -> VnpaySvc : Tạo vnp_TxnRef, vnp_Amount,\nsecure hash HMAC-SHA512
VnpaySvc --> PayCtrl : VNPAY URL
PayCtrl --> Browser : Redirect sang VNPAY Sandbox

== 3. User thanh toán ==

User -> VNPAY : Nhập thẻ test + OTP
VNPAY -> VNPAY : Xử lý giao dịch
VNPAY -> Browser : Redirect /payment/vnpay-return?...
Browser -> PayCtrl : GET /payment/vnpay-return

PayCtrl -> VnpaySvc : verifySignature(params)
VnpaySvc --> PayCtrl : valid/invalid

alt Chữ ký hợp lệ và responseCode = "00"
    PayCtrl -> DB : Load Payment theo vnp_TxnRef
    PayCtrl -> DB : UPDATE Payment\nstatus=APPROVED\npaidAt=now\napprovedAt=now
    PayCtrl -> DB : UPDATE Booking\nstatus=CONFIRMED\npaymentStatus=APPROVED\npartnerStatus=PARTNER_CONFIRMED
    PayCtrl -> NotifySvc : Thông báo cho User\n"Đã thanh toán và đã giữ phòng/căn"
    PayCtrl --> Browser : payment-result.html\nĐã thanh toán — đã giữ phòng/căn
else VNPAY thất bại / hủy / hết hạn
    PayCtrl -> DB : UPDATE Payment\nFAILED/CANCELLED/EXPIRED
    PayCtrl -> DB : UPDATE Booking CANCELLED\nMở lại phòng/căn
    PayCtrl --> Browser : payment-result.html\nThanh toán không thành công
else Chữ ký/dữ liệu bất thường
    PayCtrl -> DB : UPDATE Payment + Booking\nPENDING_ADMIN_APPROVAL
    PayCtrl --> Browser : payment-result.html\nCần TravelMate đối soát
end

== 4. Partner tiếp nhận khách ==

PartnerCtrl -> DB : GET /partner/bookings
DB --> PartnerCtrl : Booking CONFIRMED + PARTNER_CONFIRMED
PartnerCtrl --> Browser : Hiển thị nút "Check-in khách" khi tới ngày
User -> Browser : Theo dõi /my-bookings

Browser -> PartnerCtrl : POST /partner/bookings/{id}/check-in
PartnerCtrl -> DB : UPDATE bookingStatus=CHECKED_IN
PartnerCtrl -> NotifySvc : Thông báo User\n"Khách đã check-in"

== 5. Admin xử lý ngoại lệ ==

opt Chỉ khi cần đối soát/hoàn tiền/khiếu nại
    AdminCtrl -> DB : GET /admin/bookings
    AdminCtrl -> DB : Xác nhận đối soát hoặc xử lý hoàn tiền
    AdminCtrl --> Browser : Cập nhật trạng thái rõ ràng
end

@enduml
