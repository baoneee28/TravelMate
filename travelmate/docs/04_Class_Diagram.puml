@startuml TravelMate_Class_Diagram
!theme plain
skinparam classBackgroundColor #F0F8FF
skinparam classBorderColor #2980B9
skinparam arrowColor #2C3E50
skinparam packageBackgroundColor #FAFAFA

title TravelMate — Class Diagram (Entity Layer)

' ─── ENUMS ───────────────────────────────────────────────────────────────────
enum Role {
    USER
    ADMIN
    PARTNER
}

enum BookingStatus {
    PENDING_PAYMENT
    PENDING_ADMIN_APPROVAL
    CONFIRMED
    CHECKED_IN
    COMPLETED
    NO_SHOW
    CANCELLED
}

enum PaymentStatus {
    PENDING_PAYMENT
    PENDING_ADMIN_APPROVAL
    APPROVED
    REJECTED
    FAILED
    CANCELLED
    EXPIRED
    DEPOSIT_FORFEITED
    REFUND_PENDING
    REFUNDED
    NOT_REQUIRED
    SUBMITTED
}

enum PaymentOption {
    FULL_PAYMENT
    DEPOSIT_30
}

enum PaymentMethod {
    VNPAY
    MOMO_DEMO
}

enum PartnerBookingStatus {
    PENDING_PARTNER_CONFIRMATION
    PARTNER_CONFIRMED
    PARTNER_COMPLETED
    PARTNER_CANCELLED
}

enum RemainingPaymentStatus {
    NOT_REQUIRED
    UNPAID
    PAID_AT_PROPERTY
}

enum BookingSource {
    ONLINE
    DIRECT
    MANUAL_BLOCK
}

enum DiscountType {
    PERCENT
    FIXED_AMOUNT
}

enum VoucherScope {
    USER_GLOBAL
    PARTNER_ACCOMMODATION
    PARTNER_ROOM
}

enum VoucherCostBearer {
    ADMIN
    PARTNER
}

enum SettlementStatus {
    PENDING
    PAID
    CANCELLED
}

enum RoomCategory {
    STANDARD
    DELUXE
    FAMILY
    VIP
    SUITE
    OTHER
}

enum PartnerWithdrawalStatus {
    PENDING
    PAID
    REJECTED
}

enum PropertyType {
    HOTEL
    VILLA
    HOMESTAY
    RESORT
}

enum ApprovalStatus {
    PENDING
    APPROVED
    REJECTED
}

' ─── ENTITIES ─────────────────────────────────────────────────────────────────

class User {
    - id: Long
    - email: String
    - password: String
    - name: String
    - shortName: String
    - phone: String
    - role: Role
    - status: String
    - partnerPropertyType: PropertyType
    - bankAccountNumber: String
    - bankName: String
    - bankAccountHolder: String
    - bankBranch: String
    - avatarUrl: String
    - createdAt: LocalDateTime
    - updatedAt: LocalDateTime
}

enum Region {
    NORTH
    CENTRAL
    SOUTH
}

enum Category {
    GUIDE
    ATTRACTION
    ESSENTIAL
}

enum TravelPostStatus {
    VISIBLE
    HIDDEN
}

class Accommodation {
    - id: Long
    - name: String
    - description: String
    - address: String
    - city: String
    - thumbnailUrl: String
    - starRating: Integer
    - rating: Double
    - reviewCount: Integer
    - propertyType: PropertyType
    - approvalStatus: ApprovalStatus
    - owner: User
    - createdAt: LocalDateTime
}

class Room {
    - id: Long
    - roomCode: String
    - roomName: String
    - bedType: String
    - capacity: Integer
    - pricePerNight: BigDecimal
    - availableQuantity: Integer
    - availableForBooking: Boolean
    - description: String
    - imageUrl: String
    - roomCategory: RoomCategory
    - commissionRateOverride: BigDecimal
    - approvalStatus: ApprovalStatus
    - accommodation: Accommodation
}

class Amenity {
    - id: Long
    - name: String
    - icon: String
    - category: String
}

class Booking {
    - id: Long
    - bookingCode: String
    - user: User
    - accommodation: Accommodation
    - room: Room
    - checkIn: LocalDate
    - checkOut: LocalDate
    - adults: Integer
    - children: Integer
    - roomQuantity: Integer
    - customerName: String
    - customerPhone: String
    - customerEmail: String
    - totalAmount: BigDecimal
    - paymentOption: PaymentOption
    - paidAmount: BigDecimal
    - remainingAmount: BigDecimal
    - bookingStatus: BookingStatus
    - paymentStatus: PaymentStatus
    - partnerStatus: PartnerBookingStatus
    - voucherCode: String
    - discountAmount: BigDecimal
    - voucherCostBearer: String
    - totalBeforeDiscount: BigDecimal
    - commissionRateSnapshot: BigDecimal
    - commissionAmountSnapshot: BigDecimal
    - partnerVoucherAmountSnapshot: BigDecimal
    - adminVoucherAmountSnapshot: BigDecimal
    - partnerPayoutSnapshot: BigDecimal
    - onlinePaidAmountSnapshot: BigDecimal
    - onsiteAmountSnapshot: BigDecimal
    - refundAmount: BigDecimal
    - cancellationFee: BigDecimal
    - bookingSource: BookingSource
    - blockReason: String
    - remainingPaymentStatus: RemainingPaymentStatus
    - expireAt: LocalDateTime
    - createdAt: LocalDateTime
}

class RoomImage {
    - id: Long
    - room: Room
    - imageUrl: String
    - caption: String
    - sortOrder: Integer
    - primaryImage: Boolean
    - createdAt: LocalDateTime
    - updatedAt: LocalDateTime
}

class Payment {
    - id: Long
    - booking: Booking
    - paymentMethod: PaymentMethod
    - paymentOption: PaymentOption
    - amount: BigDecimal
    - transactionCode: String
    - paymentStatus: PaymentStatus
    - paidAt: LocalDateTime
    - approvedAt: LocalDateTime
    - vnpTxnRef: String
    - vnpTransactionNo: String
    - vnpBankCode: String
    - vnpBankTranNo: String
    - vnpCardType: String
    - vnpResponseCode: String
    - vnpTransactionStatus: String
    - vnpPayDate: String
    - expireAt: LocalDateTime
}

class Voucher {
    - id: Long
    - code: String
    - name: String
    - discountType: DiscountType
    - discountValue: BigDecimal
    - maxDiscountAmount: BigDecimal
    - minOrderAmount: BigDecimal
    - startDate: LocalDate
    - endDate: LocalDate
    - active: Boolean
    - voucherScope: VoucherScope
    - costBearer: VoucherCostBearer
    - owner: User
    - accommodation: Accommodation
    - room: Room
    + isCurrentlyValid(): boolean
}

class Review {
    - id: Long
    - user: User
    - accommodation: Accommodation
    - booking: Booking
    - rating: Integer
    - comment: String
    - isHidden: Boolean
    - createdAt: LocalDateTime
}

class PartnerSettlement {
    - id: Long
    - partner: User
    - periodStart: LocalDate
    - periodEnd: LocalDate
    - grossAmount: BigDecimal
    - commissionAmount: BigDecimal
    - voucherDeductionAmount: BigDecimal
    - payoutAmount: BigDecimal
    - scheduledPayoutDate: LocalDate
    - settlementStatus: SettlementStatus
    - settlementDate: LocalDateTime
    - note: String
}

class PartnerWallet {
    - id: Long
    - partner: User
    - availableBalance: BigDecimal
    - pendingWithdrawalAmount: BigDecimal
    - totalEarnedAmount: BigDecimal
    - totalWithdrawnAmount: BigDecimal
    - updatedAt: LocalDateTime
}

class PartnerWithdrawalRequest {
    - id: Long
    - partner: User
    - requestCode: String
    - amount: BigDecimal
    - bankName: String
    - bankAccountNumber: String
    - bankAccountHolder: String
    - withdrawalStatus: PartnerWithdrawalStatus
    - requestedAt: LocalDateTime
    - processedAt: LocalDateTime
}

class PartnerWalletTransaction {
    - id: Long
    - partner: User
    - settlement: PartnerSettlement
    - withdrawalRequest: PartnerWithdrawalRequest
    - transactionCode: String
    - transactionType: String
    - direction: String
    - amount: BigDecimal
    - balanceBefore: BigDecimal
    - balanceAfter: BigDecimal
    - createdAt: LocalDateTime
}

class SupportTicket {
    - id: Long
    - requesterRole: String
    - partner: User
    - user: User
    - requesterName: String
    - requesterEmail: String
    - category: String
    - subject: String
    - priority: String
    - description: String
    - status: String
    - adminResponse: String
}

class TravelDestination {
    - id: Long
    - name: String
    - slug: String
    - region: Region
    - imageUrl: String
    - shortDescription: String
    - active: Boolean
    - displayOrder: Integer
    - createdAt: LocalDateTime
}

class TravelPost {
    - id: Long
    - title: String
    - destinationName: String
    - destinationSlug: String
    - summary: String
    - content: String
    - thumbnailUrl: String
    - sourceUrl: String
    - sourceName: String
    - category: Category
    - status: TravelPostStatus
    - createdBy: String
    - createdAt: LocalDateTime
    - updatedAt: LocalDateTime
}

class AdminActionLog {
    - id: Long
    - adminEmail: String
    - actionType: String
    - targetType: String
    - targetId: Long
    - description: String
    - note: String
    - createdAt: LocalDateTime
}

class Notification {
    - id: Long
    - user: User
    - title: String
    - message: String
    - type: String
    - targetUrl: String
    - isRead: Boolean
    - createdAt: LocalDateTime
}

' ─── RELATIONSHIPS ────────────────────────────────────────────────────────────

' Ownership
User "1" --o "0..*" Accommodation : owns >
Accommodation "1" --o "0..*" Room : contains >
Room "1" --o "0..*" RoomImage : gallery >

' Room amenities (N-N)
Room "0..*" -- "0..*" Amenity : has >

' Booking relationships
Booking "0..*" --> "1" User : placed by >
Booking "0..*" --> "1" Accommodation : at >
Booking "0..*" --> "1" Room : reserves >
Booking "1" --o "0..1" Payment : paid via >
Booking "1" --o "0..1" Review : reviewed by >

' Voucher relationships
Voucher "0..*" --> "0..1" User : owned by >
Voucher "0..*" --> "0..1" Accommodation : for >
Voucher "0..*" --> "0..1" Room : for >

' Settlement
PartnerSettlement "0..*" --> "1" User : for partner >
PartnerWallet "0..1" --> "1" User : belongs to partner >
PartnerWithdrawalRequest "0..*" --> "1" User : requested by partner >
PartnerWalletTransaction "0..*" --> "1" User : for partner >
PartnerWalletTransaction "0..*" --> "0..1" PartnerSettlement : credits >
PartnerWalletTransaction "0..*" --> "0..1" PartnerWithdrawalRequest : withdraws >

' Support
SupportTicket "0..*" --> "0..1" User : from partner >
SupportTicket "0..*" --> "0..1" User : from user >

' Travel
note right of TravelPost
  TravelPost lưu destinationName/destinationSlug.
  Không có khóa ngoại JPA trực tiếp sang TravelDestination.
end note

' Notifications
Notification "0..*" --> "1" User : sent to >

' Enum usage
Booking ..> BookingStatus
Booking ..> PaymentStatus
Booking ..> PaymentOption
Booking ..> BookingSource
Booking ..> PartnerBookingStatus
Booking ..> RemainingPaymentStatus
Payment ..> PaymentMethod
Payment ..> PaymentStatus
Payment ..> PaymentOption
Voucher ..> DiscountType
Voucher ..> VoucherScope
Voucher ..> VoucherCostBearer
PartnerSettlement ..> SettlementStatus
PartnerWithdrawalRequest ..> PartnerWithdrawalStatus
TravelDestination ..> Region
TravelPost ..> Category
TravelPost ..> TravelPostStatus
User ..> Role
Accommodation ..> PropertyType
Accommodation ..> ApprovalStatus
Room ..> ApprovalStatus
Room ..> RoomCategory

@enduml
