@startuml TravelMate_UseCase_Diagram
!theme plain
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor #E8F4FD
    BorderColor #2980B9
    ArrowColor #2C3E50
}

title TravelMate — Use Case Diagram

actor "Guest\n(Khách vãng lai)" as Guest
actor "User\n(Khách hàng)" as User
actor "Partner\n(Đối tác)" as Partner
actor "Admin\n(Quản trị viên)" as Admin
actor "VNPAY\n(Cổng thanh toán)" as VNPAY <<external>>

Guest <|-- User
User <|-- Partner
User <|-- Admin

rectangle "TravelMate System" {

    package "Công Khai & Nội Dung" {
        usecase "Tìm kiếm chỗ lưu trú" as UC_Search
        usecase "Xem chi tiết phòng/căn" as UC_ViewRoom
        usecase "Xem bài gợi ý du lịch" as UC_TravelPost
        usecase "Chatbot tư vấn" as UC_Chatbot
        usecase "Xem voucher khả dụng" as UC_ViewVoucher
    }

    package "User Booking" {
        usecase "Đăng ký / Đăng nhập" as UC_Auth
        usecase "Đặt phòng" as UC_Book
        usecase "Thanh toán VNPAY\n(Cọc 30% / 100%)" as UC_Pay
        usecase "Áp mã voucher" as UC_ApplyVoucher
        usecase "Xem lịch sử đặt phòng" as UC_MyBookings
        usecase "Hủy đặt phòng / yêu cầu hoàn tiền" as UC_Cancel
        usecase "Đánh giá sau lưu trú" as UC_Review
    }

    package "Admin" {
        usecase "Đối soát giao dịch ngoại lệ" as UC_Reconcile
        usecase "Duyệt cơ sở/phòng" as UC_ApproveListing
        usecase "Tạo voucher\nphạm vi + costBearer" as UC_AdminVoucher
        usecase "Xử lý hủy / hoàn tiền / khiếu nại" as UC_Exception
        usecase "Tạo quyết toán tháng" as UC_Settlement
        usecase "Xử lý yêu cầu rút tiền" as UC_Withdrawal
        usecase "Xem báo cáo doanh thu" as UC_Revenue
        usecase "Quản lý người dùng" as UC_ManageUsers
        usecase "Quản lý bài viết du lịch" as UC_ManagePosts
        usecase "Xử lý hỗ trợ" as UC_Support
    }

    package "Partner" {
        usecase "Quản lý cơ sở lưu trú" as UC_ManageAccom
        usecase "Quản lý phòng/căn" as UC_ManageRoom
        usecase "Xem/gắn voucher được cấp" as UC_AssignVoucher
        usecase "Xác nhận giữ phòng" as UC_ConfirmHold
        usecase "Check-in khách" as UC_CheckIn
        usecase "Thu 70% tại cơ sở\nvới booking cọc" as UC_Remaining
        usecase "Check-out / hoàn tất" as UC_CheckOut
        usecase "Xem doanh thu, settlement, ví" as UC_PartnerRevenue
        usecase "Gửi yêu cầu rút tiền" as UC_RequestWithdrawal
        usecase "Gửi yêu cầu hỗ trợ" as UC_SubmitTicket
    }
}

Guest --> UC_Search
Guest --> UC_ViewRoom
Guest --> UC_TravelPost
Guest --> UC_Chatbot
Guest --> UC_Auth

User --> UC_Book
User --> UC_Pay
User --> UC_ApplyVoucher
User --> UC_MyBookings
User --> UC_Cancel
User --> UC_Review
User --> UC_ViewVoucher

Partner --> UC_ManageAccom
Partner --> UC_ManageRoom
Partner --> UC_AssignVoucher
Partner --> UC_ConfirmHold
Partner --> UC_CheckIn
Partner --> UC_Remaining
Partner --> UC_CheckOut
Partner --> UC_PartnerRevenue
Partner --> UC_RequestWithdrawal
Partner --> UC_SubmitTicket

Admin --> UC_Reconcile
Admin --> UC_ApproveListing
Admin --> UC_AdminVoucher
Admin --> UC_Exception
Admin --> UC_Settlement
Admin --> UC_Withdrawal
Admin --> UC_Revenue
Admin --> UC_ManageUsers
Admin --> UC_ManagePosts
Admin --> UC_Support

UC_Book ..> UC_ApplyVoucher : <<include>>
UC_Book ..> UC_Pay : <<include>>
UC_Pay --> VNPAY : <<uses>>
UC_Settlement ..> UC_AdminVoucher : <<uses costBearer>>
UC_PartnerRevenue ..> UC_RequestWithdrawal : <<extend>>
UC_Reconcile ..> UC_Exception : <<extend>>

@enduml
